{
  "name": "@influxdata/giraffe",
  "version": "2.38.1",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/influxdata/giraffe.git",
    "directory": "giraffe"
  },
  "scripts": {
    "build": "rm -rf dist && rolldown -c rolldown.config.ts && tsc --emitDeclarationOnly --declaration --outDir dist",
    "lint": "oxlint src",
    "prettier": "prettier --config ../.prettierrc.json --check '{src,../stories/src}/**/*.{ts,tsx}'",
    "prettier:fix": "prettier --config ../.prettierrc.json --write '{src,../stories/src}/**/*.{ts,tsx}'",
    "prettier:all": "prettier --config ../.prettierrc.json --check '{src,../stories/src}/**/*.{ts,tsx}'",
    "prettier:all:fix": "prettier --config ../.prettierrc.json --write '{src,../stories/src}/**/*.{ts,tsx}'",
    "publish": "echo 'To publish giraffe, run ./publish $version'",
    "start": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty"
  },
  "keywords": [
    "band",
    "data",
    "gauge",
    "giraffe",
    "graph",
    "heatmap",
    "histogram",
    "mosaic",
    "influxdb",
    "layer",
    "line",
    "plot",
    "scatter",
    "stat",
    "table",
    "time series",
    "timescale",
    "visualization"
  ],
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30",
    "@types/loader-utils": "^3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "classnames": "^2.2.3",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "jsdom": "^30.0.1",
    "leaflet": "^1.6.0",
    "leaflet.markercluster": "^1.4.1",
    "loader-utils": "^2.0.4",
    "memoize-one": "^6.0.0",
    "oxlint": "^1.80.0",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^2.6.3",
    "react-leaflet-control": "^2.1.2",
    "react-leaflet-markercluster": "^2.0.0",
    "rolldown": "^1.2.5",
    "sass": "^1.103.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "merge-images": "^2.0.0"
  }
}
