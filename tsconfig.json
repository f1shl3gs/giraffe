{
  "compilerOptions": {
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "target": "es2023",
    "types": [
      "vitest/globals"
    ],
    "typeRoots": [
      "node_modules/@types",
      "node_modules"
    ],
    "isolatedModules": true,
    "skipLibCheck": true,

    // import path
    "paths": {
      // Explicit rather than a "*" wildcard: with "*", every bare specifier
      // (including npm packages like `d3-shape`) is first looked up under
      // src/, and tsgo gives up on the importing module's own exports when
      // that probe misses.
      "components/*": ["./src/components/*"],
      // No bare "constants" entry on purpose. tsgo (TS 7) silently drops the
      // exports of a non-wildcard `paths` entry when it resolves to a file --
      // `from 'constants'` reported "has no exported member" for every name in
      // src/constants/index.ts, while the identical target reached through the
      // wildcard below worked. So import `from 'constants/index'` instead.
      "constants/*": ["./src/constants/*"],
      "stories/*": ["./stories/*"],
      "style/*": ["./src/style/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src",
    "stories",
    "typings.d.ts",
    "assets.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}
