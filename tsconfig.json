{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    // TS7 (tsgo) defaults to strict mode when `strict` is not explicitly set;
    // commenting out strict options does NOT relax them, so an explicit false is required.
    // Re-enable each strict option below as needed, verifying with `yarn build`.
    "strict": false,
    // Relaxed: source has many implicit any (e.g. event params in useMousePos.ts, '_' in useHoverPointIndices.ts); re-enable after annotating types
    // "noImplicitAny": true,
    // Relaxed: some functions don't cover every return path (e.g. mixins.ts); re-enable after adding missing returns
    // "noImplicitReturns": true,
    // Relaxed: mixins.ts uses a `this`-mixin pattern (getLatLonMixin.bind(this)); cannot enable until `this` is typed
    // "noImplicitThis": true,
    // Relaxed: historically loose checks, many `possibly undefined` cases to fix first (e.g. useDragEvent/initDrag); biggest lift, enable last
    // "strictNullChecks": true,
    // Relaxed: several unused imports (e.g. React) need cleanup first
    // "noUnusedLocals": true,
    "sourceMap": true,
    "target": "es2023",
    "types": [
      "vitest/globals"
    ],
    "typeRoots": [
      "node_modules/@types",
      "node_modules"
    ],
    "isolatedModules": true,
    "skipLibCheck": true,

    // import path
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "typings.d.ts",
    "assets.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}
