{
  "name": "@influxdata/giraffe",
  "version": "3.0.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/influxdata/giraffe.git",
    "directory": "giraffe"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "biome format --write .",
    "lint": "biome check .",
    "publish": "echo 'To publish giraffe, run ./publish $version'",
    "start": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:watch": "tsc --noEmit --pretty --watch",
    "prepack": "tsdown",
    "storybook": "storybook dev -p 50000",
    "storybook:build": "storybook build -o storybook-static"
  },
  "keywords": [
    "band",
    "data",
    "gauge",
    "giraffe",
    "graph",
    "heatmap",
    "histogram",
    "mosaic",
    "influxdb",
    "layer",
    "line",
    "plot",
    "scatter",
    "stat",
    "table",
    "time series",
    "timescale",
    "visualization"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "^0.23.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30",
    "@types/leaflet": "^1.9.20",
    "@types/loader-utils": "^3",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "classnames": "^2.2.3",
    "jsdom": "^30.0.1",
    "loader-utils": "^2.0.4",
    "memoize-one": "^6.0.0",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "storybook": "^10.5.10",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.4.1"
  }
}
